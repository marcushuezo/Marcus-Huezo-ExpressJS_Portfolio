<h1 class="mb-4">About Me</h1>
<div class="mb-5 d-flex justify-content-center">
  <video class="intro-video rounded" controls preload="metadata"
    poster="/images/marcus.jpg" aria-label="Introduction video">
    <source src="/videos/Video%20Project%202.mp4" type="video/mp4">
    <a href="/videos/Video%20Project%202.mp4">Introduction video</a>
  </video>
</div>
<section class="mb-5">
  <h2 class="mb-3">Experience</h2>

  <div class="row row-cols-1 row-cols-lg-2 g-3">
    <div class="col">
      <article class="card portfolio-card h-100 p-4">
        <img class="experience-logo mb-3" src="/images/agf.jpg" alt="AGF Investments logo">
        <h3 class="h4">AGF Investments</h3>
        <p class="fw-semibold">Junior Technical Support Analyst Intern | Summer 2026</p>
        <ul class="mb-0">
          <li>Imaged and deployed 92+ Windows devices using SCCM and BitLocker, reducing provisioning from two days to same-day delivery.</li>
          <li>Resolved and documented 190+ incidents and service requests in ServiceNow.</li>
          <li>Supported onboarding and access provisioning using Active Directory, Microsoft Entra ID, and Intune.</li>
          <li>Troubleshot VPN, MFA, mapped drives, and docking issues and helped test enterprise software rollouts.</li>
        </ul>
      </article>
    </div>
    <div class="col">
      <article class="card portfolio-card h-100 p-4">
        <img class="experience-logo mb-3" src="/images/whitby-fc.png" alt="Whitby FC logo">
        <h3 class="h4">Whitby FC</h3>
        <p class="fw-semibold">Ontario Soccer Certified Entry Level Referee | May 2020 - May 2026</p>
        <ul class="mb-0">
          <li>Officiated competitive youth and adult soccer matches, making accurate, time-sensitive decisions under Ontario Soccer guidelines and FIFA Laws of the Game.</li>
          <li>Communicated professionally with players, coaches, spectators, and officials, resolving disagreements calmly while maintaining match control.</li>
        </ul>
      </article>
    </div>
  </div>
</section>
<section class="mb-5">
  <h2 class="mb-3">Certifications</h2>
  <article class="card portfolio-card p-4 flex-sm-row align-items-start gap-3">
    <img class="cert-badge" src="/images/az-900.jpg" alt="Microsoft Azure Fundamentals badge">
    <div>
      <h3 class="h4">Microsoft Azure Fundamentals (AZ-900) | Certified - November 2026</h3>
      <p class="mb-0">Gained foundational knowledge of Azure compute, networking, storage, identity, security, governance, and cost management.</p>
    </div>
  </article>
  <article class="card portfolio-card p-4 mt-3 flex-sm-row align-items-start gap-3">
  <div class="security-badge-frame">
    <img class="cert-badge" src="/images/security%2B.png" alt="CompTIA Security+ logo">
    </div>
    <div>
      <h3 class="h4">CompTIA Security+ | Anticipated - January 2027</h3>
      <p class="mb-0">I am currently studying threat mitigation, network and cloud security, identity and access management, and incident response.</p>
    </div>
  </article>
</section>

<section class="mb-5">
  <h2 class="mb-3">Interests and Hobbies</h2>
  <div class="card portfolio-card p-4">
    <p class="mb-0">Outside of school, I go to the gym, play soccer and love travelling the world. I also enjoy investing, trading options and keeping up with financial markets. In my spare time, I watch podcasts like The Iced Coffee Hour and a few of my favorite Twitch streamers.</p>
  </div>
</section>

<section>
  <h2 class="mb-3">Places I've Visited</h2>
  <div class="row row-cols-1 row-cols-sm-3 g-3">
    <% for (const place of travel) { %>
      <div class="col">
        <figure class="card portfolio-card overflow-hidden h-100 mb-0">
          <img class="travel-photo" src="/images/<%= place.image %>"
            alt="<%= place.alt %>" loading="lazy">
          <figcaption class="p-3 fw-semibold"><%= place.city %></figcaption>
        </figure>
      </div>
    <% } %>
  </div>
</section>