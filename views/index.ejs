<section class="card portfolio-card p-4 p-lg-5">
  <div class="row align-items-center g-4 g-lg-5">
    <div class="col-md-5 order-md-2 text-center">
      <img class="profile-photo img-fluid rounded-circle"
        src="/images/marcus.jpg" alt="Portrait of Marcus Huezo">
    </div>

    <div class="col-md-7 order-md-1">
      <h1 class="display-5 mb-3">Hi, I'm Marcus Huezo</h1>
      <p class="lead">I'm a second-year Networking and Information Technology Security student at Ontario Tech University.</p>
      <p>This past summer, I interned as a Junior Technical Support Analyst at AGF Investments, where I supported users and helped solve technical issues. I'm interested in cybersecurity and cloud engineering.</p>
      <p>Outside of school, I enjoy playing and refereeing soccer, travelling, and following financial markets.</p>
      <h2 class="h4 mt-4 mb-3">More about me</h2>
      <p>Visit my About Me and Projects pages to learn more about my internship experience, the technical skills I'm building, my interests outside of school, and the projects I have built.</p>
      <div class="d-flex flex-wrap gap-2 mt-4">
        <a class="btn btn-primary" href="/about">Learn more about me</a>
        <a class="btn btn-outline-primary" href="/projects">View my projects</a>
      </div>
    </div>
  </div>
</section>
<section class="mt-5">
  <h2 class="h4 fw-bold mb-4">Connect with Me</h2>

  <div class="row row-cols-1 row-cols-lg-3 g-3 g-lg-4 g-xl-5">
    <div class="col">
      <div class="connect-box h-100">
        <h3>Email</h3>
        <a href="mailto:<%= site.email %>"><%= site.email %></a>
      </div>
    </div>

    <div class="col">
      <div class="connect-box h-100">
        <h3>GitHub</h3>
        <a href="https://github.com/marcushuezo?tab=repositories">View my GitHub</a>
      </div>
    </div>

    <div class="col">
      <div class="connect-box h-100">
        <h3>LinkedIn</h3>
        <a href="https://www.linkedin.com/in/marcushuezo/">View my LinkedIn</a>
      </div>
    </div>
  </div>
</section>